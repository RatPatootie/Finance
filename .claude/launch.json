{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "http-server@14.1.1", "frontend/dist/frontend/browser", "-p", "8080", "-c-1", "--proxy", "http://localhost:8080?"],
      "port": 8080
    },
    {
      "name": "frontend-prod-scratch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "http-server@14.1.1", "frontend/dist/frontend/browser", "-p", "8081", "-c-1", "--proxy", "http://localhost:8081?"],
      "port": 8081
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "start"],
      "port": 4200
    }
  ]
}
